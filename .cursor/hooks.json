{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/hooks/session-start.sh",
        "timeout": 10
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": ".cursor/hooks/detect-readonly-prompt.sh"
      },
      {
        "command": ".cursor/hooks/intent-context-injection.sh"
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/triple-pass-loop.sh",
        "loop_limit": 3
      },
      {
        "command": ".cursor/hooks/policy-reminders.sh",
        "loop_limit": 1
      },
      {
        "command": ".cursor/hooks/stop-auto-review.sh",
        "loop_limit": 1
      }
    ],
    "subagentStop": [
      {
        "command": ".cursor/hooks/subagent-stop-loop.sh",
        "matcher": "bugbot|security-review",
        "loop_limit": 3
      }
    ],
    "sessionEnd": [
      {
        "command": ".cursor/hooks/cleanup-session.sh"
      }
    ]
  }
}
