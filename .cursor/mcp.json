{
  "mcpServers": {
    "playwright": {
      "command": "pnpm",
      "args": [
        "dlx",
        "@playwright/mcp@0.0.32",
        "--headless",
        "--browser=chromium",
        "--viewport-size=1440,900",
        "--allowed-origins=http://localhost:5173;http://127.0.0.1:5173"
      ]
    },
    "fetch": {
      "command": "bash",
      "args": ["scripts/mcp-fetch.sh"]
    },
    "context7": {
      "command": "pnpm",
      "args": ["dlx", "@upstash/context7-mcp"],
      "env": {
        "CONTEXT7_API_KEY": "${env:CONTEXT7_API_KEY}"
      }
    },
    "semantic-context": {
      "command": "bash",
      "args": ["scripts/mcp-semantic-context.sh"]
    }
  }
}
