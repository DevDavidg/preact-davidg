{
  "name": "preact-davidg",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.32.0",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && pnpm run sitemap",
    "verify": "pnpm run build && pnpm run budget && pnpm exec tsx scripts/diagnose.ts",
    "typecheck": "react-router typegen && tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "budget": "node scripts/bundle-budget.mjs",
    "sitemap": "pnpm exec tsx scripts/build-sitemap.ts",
    "fonts": "pnpm exec tsx scripts/fetch-fonts.ts",
    "shots": "pnpm exec tsx scripts/capture-shots.ts",
    "assets": "pnpm exec tsx scripts/build-assets.ts"
  },
  "dependencies": {
    "@react-router/node": "7.18.2",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "3.0.5",
    "@react-three/rapier": "2.2.0",
    "@rive-app/react-canvas": "4.32.1",
    "@theatre/core": "0.7.2",
    "gsap": "^3.15.0",
    "isbot": "^5",
    "lenis": "^1.3.25",
    "maath": "^0.10.8",
    "postprocessing": "^6.39.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "7.18.2",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@react-router/dev": "7.18.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@theatre/studio": "0.7.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.3",
    "jsdom": "^30.0.1",
    "oxlint": "^1.76.0",
    "schema-dts": "^2.0.0",
    "sharp": "^0.35.3",
    "subset-font": "^2.5.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.5",
    "typescript": "~7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
