{
  "name": "preact-davidg",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.32.0",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && pnpm run sitemap",
    "verify": "pnpm run build && pnpm run budget && pnpm exec tsx scripts/diagnose.ts",
    "typecheck": "react-router typegen && tsc -b",
    "lint": "oxlint",
    "budget": "node scripts/bundle-budget.mjs",
    "sitemap": "pnpm exec tsx scripts/build-sitemap.ts",
    "fonts": "pnpm exec tsx scripts/fetch-fonts.ts",
    "shots": "pnpm exec tsx scripts/capture-shots.ts",
    "assets": "pnpm exec tsx scripts/build-assets.ts"
  },
  "dependencies": {
    "@react-router/node": "7.18.2",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "3.0.5",
    "gsap": "^3.15.0",
    "isbot": "^5",
    "lenis": "^1.3.25",
    "maath": "^0.10.8",
    "postprocessing": "^6.39.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "7.18.2",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@react-router/dev": "7.18.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.3",
    "oxlint": "^1.85.0",
    "schema-dts": "^2.0.0",
    "sharp": "^0.35.4",
    "subset-font": "^2.5.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.5",
    "typescript": "~7.0.2",
    "vite": "^8.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "nanoid@^3": ">=3.3.18",
      "nanoid": ">=3.3.18",
      "brace-expansion@^2": ">=2.1.2",
      "brace-expansion": ">=2.1.2",
      "browserslist": ">=4.28.7",
      "postcss": ">=8.5.18",
      "minimatch@^3": ">=3.1.3",
      "minimatch@^5": ">=5.1.7",
      "minimatch@^9": ">=9.0.6",
      "path-to-regexp@>=8": ">=8.4.0",
      "vite@^7": ">=7.1.11",
      "rollup": ">=4.59.0",
      "picomatch": ">=2.3.2",
      "lodash": ">=4.18.0",
      "preact": ">=10.26.10",
      "glob@^10": ">=10.5.0",
      "qs": ">=6.14.1"
    }
  }
}
